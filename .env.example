# Ключ шифрования токенов зеркал. Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Хранить отдельно от бэкапов! Потеряете ключ - токены зеркал не расшифровать.
