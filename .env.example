# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID владельцев через запятую (узнать: @userinfobot)
OWNER_IDS=111111111

# Хранилище постов: приватный канал или группа, бот там администратор.
# ID вида -1001234567890 (узнать: @getidsbot)
STORAGE_CHAT_ID=

# Бэкап базы уходит в то же хранилище. Период в часах, 168 = раз в неделю.
BACKUP_EVERY_HOURS=168

# Необязательно
# интервал новой группы, пока не задан свой
DEFAULT_INTERVAL_HOURS=2
INVITE_TTL_HOURS=48
SEND_GAP_SECONDS=1
GROUP_GAP_SECONDS=3
DISPLAY_TZ=Asia/Almaty
DISPLAY_TZ_LABEL=Алматы
